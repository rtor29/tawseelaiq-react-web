# Tawseelaiq Web — Environment Variables
# Copy this to .env and fill in real values

VITE_API_BASE_URL=https://tawseelaiq.app
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN_HERE
# Nationwide Iraq Default Center (Auto-GPS dynamically detects local governorate)
VITE_MAP_CENTER_LNG=43.6793
VITE_MAP_CENTER_LAT=33.2232
VITE_MAP_ZOOM=7
