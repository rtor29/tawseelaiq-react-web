# ===============================================
# توصيله ويب — متغيرات البيئة (انسخ الملف إلى .env ثم عدّل القيم)
# Tawseela Web — environment variables
# ===============================================

# --- الخادم الخلفي (Backend API) ---
# عنوان الـ API. في الإنتاج على نفس الدومين (خلف Nginx) اتركه /api
# إذا كان الواجهة والخادم على دومينين مختلفين استخدم الرابط الكامل:
#   VITE_API_BASE_URL=https://tawseelaiq.app/api
VITE_API_BASE_URL=/api

# --- التتبع اللحظي (Realtime Hub) ---
# وضع الاتصال: polling لخادم Node المحلي، أو signalr لخادم .NET
# أو socketio إذا كنت ستنقل الخادم لاحقاً إلى Socket.io
VITE_REALTIME_MODE=polling

# رابط الهب. عادةً /hubs/tracking على نفس الأصل (يمرر عبر Nginx كـ WebSocket)
VITE_REALTIME_HUB_URL=/hubs/tracking

# --- خرائط Mapbox ---
# رمز الوصول العام (pk...). أنشئه من console.mapbox.com وقيد استخدامه
# على دومينك من لوحة Mapbox (Token > URL restrictions) — يُحقن في المتصفح حتماً
VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# أنماط الخرائط
VITE_MAP_STYLE=mapbox://styles/mapbox/streets-v12
VITE_NAVIGATION_STYLE=mapbox://styles/mapbox/navigation-day-v1

# --- تسجيل الدخول بجوجل (اختياري) ---
VITE_GOOGLE_CLIENT_ID=483987924711-xxxxxxxx.apps.googleusercontent.com

# --- التطوير المحلي فقط ---
# خادم Vite يمرر /api و /hubs إلى هذا العنوان
VITE_DEV_BACKEND_URL=http://127.0.0.1:5050
